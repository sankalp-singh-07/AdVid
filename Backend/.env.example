
# ─── Core ──────────────────────────────────────────────────────────────────────
DB_URL="postgresql+asyncpg://user:password@localhost:5432/knowledge_platform"
ENVIRONMENT="development"
SENTRY_DSN="YOUR_SENTRY_DSN"

# ─── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY="change-this-in-production-min-32-chars"
JWT_REFRESH_SECRET_KEY="change-this-refresh-secret-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_MINUTES=10080

# ─── Ollama — Remote LLM Server ────────────────────────────────────────────────
# Point this at your GPU VM / cloud server. NEVER leave as localhost in production.
OLLAMA_BASE_URL="http://your-ollama-server:11434"
OLLAMA_MODEL="llama3"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# ─── Qdrant Vector Database ────────────────────────────────────────────────────
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="knowledge_base"
QDRANT_VECTOR_SIZE=768

# ─── Redis Cache ───────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_TTL_SECONDS=3600

# ─── Local File Storage ────────────────────────────────────────────────────────
# In production: mount a persistent volume and set this to the mount path
STORAGE_PATH="./uploads"
MAX_UPLOAD_SIZE_MB=50

# ─── Razorpay (Subscription Billing) ───────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_YOUR_TEST_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_TEST_KEY_SECRET"
RAZORPAY_TEST_MODE=true

# ─── RAG Pipeline Tuning ───────────────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
