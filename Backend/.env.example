
# ─── Core ──────────────────────────────────────────────────────────────────────
DB_URL="postgresql+asyncpg://user:password@localhost:5432/knowledge_platform"
ENVIRONMENT="development"
SENTRY_DSN=""
FRONTEND_URLS=["http://localhost:5173","http://localhost:3000"]

# ─── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY="change-this-in-production-min-32-chars"
JWT_REFRESH_SECRET_KEY="change-this-refresh-secret-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_MINUTES=10080

# ─── LLM Provider (ollama | openai_compatible | vllm) ──────────────────────────
LLM_PROVIDER="ollama"
LLM_BASE_URL="http://localhost:11434"
LLM_MODEL="llama3"
LLM_TEMPERATURE=0.2
# Legacy aliases still work:
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3"

# OpenAI-compatible / vLLM
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# ─── Embedding Provider ────────────────────────────────────────────────────────
EMBEDDING_PROVIDER="ollama"
EMBEDDING_BASE_URL="http://localhost:11434"
EMBEDDING_MODEL="nomic-embed-text"
EMBEDDING_BATCH_SIZE=32

# ─── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="knowledge_base"
QDRANT_VECTOR_SIZE=768

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_TTL_SECONDS=3600

# ─── Storage (cloudinary | s3 | local) ─────────────────────────────────────────
STORAGE_PROVIDER="cloudinary"
STORAGE_PATH="./uploads"
MAX_UPLOAD_SIZE_MB=50

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT_URL=""
S3_PREFIX="documents"

# ─── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_TEST_MODE=true

# ─── RAG tuning ────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=8
RAG_FINAL_K=5
RAG_SCORE_THRESHOLD=0.35

# ─── Rate limits / security ────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=20
EXPOSE_RESET_CODES=false
